# Copy to .env for `pnpm dev` on your machine. In Docker, compose sets these.
NODE_ENV=development
SERVICE_NAME=template-service
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true
# localhost because the service runs on the host here; inside compose it's `postgres`.
DATABASE_URL=postgres://seatrush:seatrush@localhost:5432/seatrush
DB_CONNECT_MAX_ATTEMPTS=10
